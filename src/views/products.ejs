<%- include('includes/header') %>
<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
/>
<link rel="stylesheet" href="/css/main.css" />
<link rel="stylesheet" href="/css/users.css" />
<link rel="stylesheet" href="/css/products.css">

</head>
<body>
<div class="dashboard-container">
  <%- include('includes/navbar') %>

  <!-- Main Content -->
  <main class="main-content">
    <!-- Top Header -->
   
    <%- include('includes/top-header') %>

    <!-- Table Section -->
    <section class="table-section">
        <div class="table-header">
          <div class="table-search">
            <input id="productSearch" type="text" placeholder="Search for products" />
          </div>
        </div>
      
        <div class="table-container">
          <table id="productsTable">
            <thead>
              <tr>
                <th>PRODUCT NAME</th>
                <th>PRODUCT TYPE</th>
                <th>PRODUCT VOLUME</th>
                <th>ORIGINAL PRICE</th>
                <th>DISCOUNT PRICE</th>
                <th>PRODUCT LEFT</th>
                <th>PROMOTION</th>
                <th>PRODUCT STATUS</th>
                <th>ACTIONS</th>
              </tr>
            </thead>
      
            <tbody>
              <% products.map((product) => { %>
                <%
                  const normalizeUploadPath = (value) => {
                    if (!value) return "";
                    let normalized = String(value).trim().replace(/\\/g, "/");
                    const uploadsMatch = normalized.match(/(?:^|\/)(uploads\/.*)$/i);
                    if (uploadsMatch) {
                      normalized = `/${uploadsMatch[1]}`;
                    } else {
                      normalized = normalized
                        .replace(/^https?:\/\/[^/]+/i, "")
                        .replace(/^\/?app\/+uploads/i, "/uploads")
                        .replace(/^\/?uploads/i, "/uploads");
                    }
                    if (!normalized.startsWith("/")) normalized = `/${normalized}`;
                    return normalized.replace(/\/{2,}/g, "/");
                  };
                  const productImage = product.productImages && product.productImages[0]
                    ? normalizeUploadPath(product.productImages[0])
                    : "/img/default-food.jpg";
                %>
                <tr>
                  <td>
                    <div class="product-info">
                        <img
                            class="product-img"
                            src="<%= productImage %>"
                            alt="product"
                        />

                      
                      <div class="product-meta">
                        <div class="product-name"><%= product.productName %></div>
                      </div>
                    </div>
                  </td>
      
                  <td><%= product.productCollection %></td>
      
                  <td>
                    <%= product.productCollection === "DRINK" ? product.productVolume : product.productSize %>
                  </td>
      
                  <td><%= product.productPrice %></td>
      
                  <td>
                    <% if (product.productPriceDiscount) { %>
                      <span style="color: #dc2626; font-weight: bold;"><%= product.productPriceDiscount %></span>
                    <% } else { %>
                      <span style="color: #9ca3af;">-</span>
                    <% } %>
                  </td>
      
                  <td><%= product.productLeftCount %></td>
      
                  <td style="width: 11%">
                    <select class="spec-select product-promotion new-product-promotion" id="<%= product._id %>">
                      <option value="0" <%= product.productPromotion === 0 ? "selected" : "" %>>No Promotion</option>
                      <option value="30" <%= product.productPromotion === 30 ? "selected" : "" %>>30% OFF</option>
                      <option value="45" <%= product.productPromotion === 45 ? "selected" : "" %>>45% OFF</option>
                    </select>
                  </td>
      
                  <td style="width: 13%">
                    <select class="spec-select product-status new-product-status" id="<%= product._id %>">
                      <option value="ACTIVE" <%= product.productStatus === "ACTIVE" ? "selected" : "" %>>ACTIVE</option>
                      <option value="PROMOTION" <%= product.productStatus === "PROMOTION" ? "selected" : "" %>>PROMOTION</option>
                      <option value="PAUSED" <%= product.productStatus === "PAUSED" ? "selected" : "" %>>PAUSED</option>
                      <option value="DELETE" <%= product.productStatus === "DELETE" ? "selected" : "" %>>DELETE</option>
                    </select>
                  </td>
                  
                  <td>
                    <div class="product-actions">
                      <button class="btn-edit-product" data-product-id="<%= product._id %>" data-product-name="<%= product.productName %>" data-product-collection="<%= product.productCollection %>" data-product-price="<%= product.productPrice %>" data-product-left="<%= product.productLeftCount %>" data-product-size="<%= product.productSize %>" data-product-volume="<%= product.productVolume %>" data-product-desc="<%= (product.productDesc || '').replace(/"/g, '&quot;') %>" onclick="openEditModal(this)">
                        <i class="fas fa-edit"></i> Edit
                      </button>
                      <button
                        class="btn-hard-delete-product"
                        data-product-id="<%= product._id %>"
                        data-product-name="<%= product.productName %>"
                        data-product-status="<%= product.productStatus %>"
                        <%= product.productStatus !== "DELETE" ? "disabled" : "" %>
                        onclick="hardDeleteProduct(this)"
                        title="<%= product.productStatus === 'DELETE' ? 'Hard delete product' : 'Set status to DELETE first' %>"
                        aria-label="Hard delete product"
                      >
                        <i class="fas fa-trash"></i>
                      </button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      
        <div class="table-footer">
          <div class="pagination">
            <button class="page-nav"><i class="fas fa-chevron-left"></i></button>
            <button class="page-nav"><i class="fas fa-chevron-right"></i></button>
            <span>Total: <%= products.length %> products</span>
          </div>
      
          <div class="footer-info">
            <%
              const activeCount = products.filter(p => p.productStatus === "ACTIVE").length;
              const promotionCount = products.filter(p => p.productStatus === "PROMOTION").length;
              const pausedCount = products.filter(p => p.productStatus === "PAUSED").length;
            %>
            <i class="fas fa-box"></i>
            ACTIVE: <b><%= activeCount %></b> | PROMOTION: <b><%= promotionCount %></b> | PAUSED: <b><%= pausedCount %></b>
          </div>
        </div>
      </section>
      
  </main>
</div>

<!-- Edit Product Modal -->
<div id="editProductModal" class="modal" style="display: none;">
  <div class="modal-content" style="max-width: 600px;">
    <div class="modal-header">
      <h2>Edit Product</h2>
      <span class="close" onclick="closeEditModal()">&times;</span>
    </div>
    <div class="modal-body">
      <input type="hidden" id="editProductId" />
      
      <div class="form-group">
        <label>Product Name</label>
        <input type="text" id="editProductName" class="form-input" />
      </div>
      
      <div class="form-group">
        <label>Collection</label>
        <select id="editProductCollection" class="form-input">
          <option value="BREAKFAST">BREAKFAST</option>
          <option value="LUNCH">LUNCH</option>
          <option value="DINNER">DINNER</option>
          <option value="DRINK">DRINK</option>
          <option value="OTHER">OTHER</option>
        </select>
      </div>
      
      <div class="form-row">
        <div class="form-group">
          <label>Price</label>
          <input type="number" id="editProductPrice" class="form-input" />
        </div>
        
        <div class="form-group">
          <label>Left Count</label>
          <input type="number" id="editProductLeftCount" class="form-input" />
        </div>
      </div>
      
      <div class="form-row">
        <div class="form-group">
          <label>Size</label>
          <select id="editProductSize" class="form-input">
            <option value="SMALL">SMALL</option>
            <option value="NORMAL">NORMAL</option>
            <option value="LARGE">LARGE</option>
            <option value="SET">SET</option>
          </select>
        </div>
        
        <div class="form-group">
          <label>Volume</label>
          <select id="editProductVolume" class="form-input">
            <option value="0.5 liter">0.5 liter</option>
            <option value="1 liter">1 liter</option>
            <option value="1.2 liter">1.2 liter</option>
            <option value="1.5 liter">1.5 liter</option>
            <option value="2l">2l</option>
          </select>
        </div>
      </div>
      
      <div class="form-group">
        <label>Description</label>
        <textarea id="editProductDesc" class="form-input" rows="3"></textarea>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn-cancel" onclick="closeEditModal()">Cancel</button>
      <button class="btn-submit" onclick="submitEditProduct()">Save Changes</button>
    </div>
  </div>
</div>

<script src="/js/products.js"></script>
<%- include('includes/footer') %>
