<%- include('includes/header') %>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"/>
<link rel="stylesheet" href="/css/main.css" />
<link rel="stylesheet" href="/css/orders-stats.css" />

</head>
<body>
    <%
    const L = locals || {};
  
    const safe = (key, def = 0) =>
      typeof L[key] !== "undefined" ? L[key] : def;
  
    const pendingTodayCountSafe = safe("pendingTodayCount", 0);
    const finishedTodayCountSafe = safe("finishedTodayCount", 0);
    const todayTotalCountSafe = safe("todayTotalCount", 0);
    const revenueTodaySafe = safe("revenueToday", 0);
    const revenueMonthSafe = safe("revenueMonth", 0);
  
    const statusCountsSafe = safe("statusCounts", {
      PAUSE: 0,
      PROCESS: 0,
      FINISH: 0,
      DELETE: 0,
    });
  
    const ordersSafe = safe("orders", []);
  %>

<div class="dashboard-container">
  <%- include('includes/navbar') %>

  <main class="main-content">

    <header class="top-header">
      <div class="search-bar">
        <i class="fas fa-search"></i>
        <input id="orderSearch" type="text" placeholder="Search by order id or user..." />
      </div>

      <div class="header-actions">
        <i class="fas fa-bell"></i>
        <img src="https://i.pravatar.cc/150?u=admin" alt="Admin" class="admin-avatar" />
      </div>
    </header>

    <section class="table-section">
    <div class="page-card">
      <div class="table-header">
        <div class="table-title">
          <h2>Orders Statistics</h2>

          <span class="badge">
            Total Orders:
            <%= todayTotalCountSafe %>
          </span>
        </div>

        <div class="table-actions">
          <div class="mini-stats">

            <span class="chip chip-pending">
              PENDING TODAY: <b><%= pendingTodayCountSafe %></b>
            </span>

            <span class="chip chip-confirmed">
              FINISHED TODAY: <b><%= finishedTodayCountSafe %></b>
            </span>

            <span class="chip chip-total">
              TODAY TOTAL: <b><%= todayTotalCountSafe %></b>
            </span>

          </div>
        </div>
      </div>

      <!-- STAT CARDS -->
      <div class="stats-grid">

        <div class="stat-card">
          <div class="stat-icon">
            <i class="fa-solid fa-bag-shopping"></i>
          </div>
          <div class="stat-meta">
            <p class="stat-title">Finished Orders Today</p>
            <p class="stat-value"><%= finishedTodayCountSafe %></p>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-icon">
            <i class="fa-solid fa-clock"></i>
          </div>
          <div class="stat-meta">
            <p class="stat-title">Pending Orders Today</p>
            <p class="stat-value"><%= pendingTodayCountSafe %></p>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-icon">
            <i class="fa-solid fa-won-sign"></i>
          </div>
          <div class="stat-meta">
            <p class="stat-title">Revenue Today</p>
            <p class="stat-value">
              <%= revenueTodaySafe.toLocaleString("ko-KR") %> WON
            </p>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-icon">
            <i class="fa-solid fa-chart-line"></i>
          </div>
          <div class="stat-meta">
            <p class="stat-title">Revenue This Month</p>
            <p class="stat-value">
              <%= revenueMonthSafe.toLocaleString("ko-KR") %> WON
            </p>
          </div>
        </div>

      </div>

      <!-- RECENT ORDERS TABLE -->
      <div class="table-container">
        <table id="ordersTable">

          <thead>
            <tr>
              <th style="width:60px">#</th>
              <th>ORDER ID</th>
              <th>USER</th>
              <th>DATE / TIME</th>
              <th>AMOUNT</th>
              <th style="width:180px">STATUS</th>
            </tr>
          </thead>

          <tbody>
            <% ordersSafe.slice(0, 15).map(function(o, idx){ %>
              <tr>
                <td><%= idx + 1 %></td>

                <td class="mono"><%= o._id %></td>

                <td>
                  <%= o?.memberNick || o?.userNick || o?.customerName || '-' %>
                </td>

                <td>
                  <%= new Date(o.createdAt || Date.now()).toLocaleString("en-GB", {
                    timeZone: "Asia/Seoul",
                    year: "numeric",
                    month: "short",
                    day: "2-digit",
                    hour: "2-digit",
                    minute: "2-digit",
                    hour12: false,
                  }) %>
                </td>

                <td>
                  <%= (o.orderTotal || 0).toLocaleString("ko-KR") %> WON
                </td>

                <td>
                  <span class="status-pill status-<%= String(o.orderStatus || 'PENDING').toLowerCase() %>">
                    <%= o.orderStatus || 'PENDING' %>
                  </span>
                </td>

              </tr>
            <% }) %>
          </tbody>

        </table>
      </div>
    </div>
    </section>

  </main>
</div>

<script src="/js/orders.js"></script>

<%- include('includes/footer') %>
