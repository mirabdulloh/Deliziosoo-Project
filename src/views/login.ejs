<%- include('includes/header') %>

<link rel="stylesheet" href="/css/login.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>

<body>
  <div class="auth-page">
    <div class="auth-card">
      <div class="brand">
        <img src="/img/Logo_Delizioso.svg" alt="Delizioso" class="brand-logo" />
        <h1>Welcome back</h1>
        <p>Login to manage your restaurant dashboard.</p>
      </div>

      <% if (typeof message !== "undefined" && message) { %>
        <div class="alert">
          <i class="fa-solid fa-circle-exclamation"></i>
          <%= message %>
        </div>
      <% } %>

      <form class="auth-form" method="POST" action="/admin/login" autocomplete="on">
        <!-- NICKNAME -->
        <label class="field">
          <span>Restaurant Nickname</span>
          <div class="input">
            <i class="fa-solid fa-store"></i>
            <input
              type="text"
              name="memberNick"
              placeholder="e.g. delizioso_admin"
              required
            />
          </div>
        </label>

        <!-- PASSWORD -->
        <label class="field">
          <span>Password</span>
          <div class="input">
            <i class="fa-solid fa-lock"></i>
            <input
              id="password"
              type="password"
              name="memberPassword"
              placeholder="••••••••"
              required
              minlength="6"
            />
            <button class="toggle" type="button" onclick="togglePass('password', this)">
              <i class="fa-regular fa-eye"></i>
            </button>
          </div>
        </label>

        <div class="row">
          <a class="link" href="/admin/signup">Not signed up? Sign up</a>
          <a class="link muted" href="/admin">Back</a>
        </div>

        <button class="btn primary" type="submit">
          <i class="fa-solid fa-right-to-bracket"></i>
          Login
        </button>
      </form>
    </div>
  </div>

  <script>
    function togglePass(id, btn) {
      const input = document.getElementById(id);
      const icon = btn.querySelector("i");
      const isPass = input.type === "password";
      input.type = isPass ? "text" : "password";
      icon.className = isPass ? "fa-regular fa-eye-slash" : "fa-regular fa-eye";
    }
  </script>
</body>

<%- include('includes/footer') %>
