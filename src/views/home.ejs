<body>

<!-- Sidebar -->
<%- include('includes/navbar') %>

<!-- Main Content -->
<main class="main-content">
  <!-- Top Bar -->
  <%- include('includes/top-header') %>

  <!-- Dashboard Content -->
  <div class="dashboard-content">

    <!-- Food Showcase -->
    <section class="showcase">
      <div class="showcase-head">
      
      </div>
    
      <div class="img-grid-pro">
        <a class="tile normal" href="#">
          <img src="https://images.unsplash.com/photo-1550547660-d9450f859349?auto=format&fit=crop&w=2000&q=80" alt="Classic Burger" />
          <div class="tile-overlay"><span>Classic Burger</span></div>
        </a>
      
        <a class="tile wide" href="#">
          <img src="https://images.unsplash.com/photo-1601924582975-5e74d4d0c5f3?auto=format&fit=crop&w=2000&q=80" alt="Pepperoni Pizza" />
          <div class="tile-overlay"><span>Pepperoni Pizza</span></div>
        </a>
      
        <a class="tile wide" href="#">
          <img src="https://images.unsplash.com/photo-1523986371872-9d3ba2e2a389?auto=format&fit=crop&w=2000&q=80" alt="Creamy Pasta" />
          <div class="tile-overlay"><span>Creamy Pasta</span></div>
        </a>
      
        <a class="tile normal" href="#">
          <img src="https://images.unsplash.com/photo-1505253213348-8b2b496df3c6?auto=format&fit=crop&w=2000&q=80" alt="Sweet Dessert" />
          <div class="tile-overlay"><span>Sweet Dessert</span></div>
        </a>
      
        <a class="tile normal" href="#">
          <img src="https://images.unsplash.com/photo-1551024601-bec78aea704b?auto=format&fit=crop&w=2000&q=80" alt="Donuts" />
          <div class="tile-overlay"><span>Donuts</span></div>
        </a>
      
        <a class="tile normal" href="#">
          <img src="https://images.unsplash.com/photo-1540189549336-e6e99c3679fe?auto=format&fit=crop&w=2000&q=80" alt="Healthy Bowl" />
          <div class="tile-overlay"><span>Healthy Bowl</span></div>
        </a>
      </div>
      
    </section>
    

  </div>
</main>

<!-- Chart.js Library -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
