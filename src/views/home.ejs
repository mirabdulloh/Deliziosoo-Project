<%- include('includes/header') %>

<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
/>
<link rel="stylesheet" href="/css/main.css" />
<link rel="stylesheet" href="/css/home.css" />

</head>
<body>

<!-- Sidebar -->
<%- include('includes/navbar') %>

<!-- Main Content -->
<main class="main-content">
  <!-- Top Bar -->
  <%- include('includes/top-header') %>

  <!-- Dashboard Content -->
  <div class="dashboard-content">

    <!-- Food Showcase -->
    <section class="showcase">
      <div class="showcase-head">
      
      </div>
    
      <div class="img-grid-pro">
        <a class="tile normal" href="#">
          <img src="/img/Bolognese.jpg" alt="Classic Burger" />
          <div class="tile-overlay"><span>Alfredo Pasta</span></div>
        </a>
      
        <a class="tile wide" href="#">
          <img src="/img/italian-2.jpg" alt="Pepperoni Pizza" />
          <div class="tile-overlay"><span>Pastas</span></div>
        </a>
      
        <a class="tile wide" href="#">
          <img src="/img/lasagna-coperta.jpg" alt="Creamy Pasta" />
          <div class="tile-overlay"><span>Pepperoni Pizza</span></div>
        </a>
      
        <a class="tile normal" href="#">
          <img src="/img/Lupa-Editorial-Pics.jpg" alt="Sweet Dessert" />
          <div class="tile-overlay"><span>Pasta Carbonara</span></div>
        </a>
      
        <a class="tile normal" href="#">
          <img src="/img/pastas.jpg" alt="Donuts" />
          <div class="tile-overlay"><span>Spicy Pasta</span></div>
        </a>
      
        <a class="tile normal" href="#">
          <img src="/img/healthy-bowl.avif" alt="Healthy Bowl" />
          <div class="tile-overlay"><span>Healthy Bowl</span></div>
        </a>
      </div>
      
    </section>
    

  </div>
</main>

<!-- Chart.js Library -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="/js/home.js"></script>

<%- include('includes/footer') %>
