<link rel="stylesheet" href="/css/home.css" />
<aside class="sidebar">
  <div class="sidebar-header">
    <div class="logo">
      <img src="/img/Logo_Delizioso.svg" alt="Delizioso" />
    </div>
   
  </div>

  <!-- ALWAYS SHOW -->
   
  <a href="/admin"
  class="nav-item <%= currentPath === '/admin' ? 'active' : '' %>">
  <i class="fas fa-chart-pie"></i>
  <span>Dashboard</span>
</a>

<a href="/admin/user/all"
  class="nav-item <%= currentPath.includes('/admin/user') ? 'active' : '' %>">
  <i class="fas fa-users"></i>
  <span>Users</span>
</a>

<a href="/admin/product/all"
  class="nav-item <%= currentPath.includes('/admin/product') && !currentPath.includes('/admin/product/create') ? 'active' : '' %>">
  <i class="fas fa-shopping-bag"></i>
  <span>Products</span>
</a>

<a href="/admin/product/create"
  class="nav-item <%= currentPath.includes('/admin/product/create') ? 'active' : '' %>">
  <i class="fas fa-plus-circle"></i>
  <span>New Product</span>
</a>


<a href="/admin/orders/stats"
  class="nav-item <%= currentPath.includes('/admin/orders') ? 'active' : '' %>">
  <i class="fas fa-list"></i>
  <span>Orders</span>
</a>

<a href="/admin/reviews"
  class="nav-item <%= currentPath.includes('/admin/reviews') ? 'active' : '' %>">
  <i class="fas fa-star"></i>
  <span>Reviews</span>
</a>

<a href="/admin/getAll/reservations"
  class="nav-item <%= currentPath.includes('/reservations') ? 'active' : '' %>">
  <i class="fas fa-calendar"></i>
  <span>Reservations</span>
</a>

<a href="/admin/settings"
  class="nav-item <%= currentPath.includes('/settings') ? 'active' : '' %>">
  <i class="fas fa-cog"></i>
  <span>Settings</span>
</a>

<!-- Spacer to push logout to bottom -->
<div style="flex: 1;"></div>

<!-- Logout Button -->
<a href="/admin/logout"
  class="nav-item logout-btn"
  onclick="return confirm('Are you sure you want to logout?')">
  <i class="fas fa-sign-out-alt"></i>
  <span>Logout</span>
</a>

</aside>



  
