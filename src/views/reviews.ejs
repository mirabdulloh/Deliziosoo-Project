<%
  const serverApi = process.env.SERVER_API || "http://localhost:3009";
%>

<%- include('includes/header') %>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"/>
<link rel="stylesheet" href="/css/main.css" />
<link rel="stylesheet" href="/css/review.css" />

</head>
<body>
    <div class="dashboard-container">
        <%- include('includes/navbar') %>

        <main class="main-content">
            <%- include('includes/top-header') %>

            <div class="content-wrapper">
                <div class="page-header">
                    <h1>Reviews Management</h1>
                    <div class="header-actions">
                        <div class="filter-section">
                            <select id="filterRating" class="filter-select">
                                <option value="">All Ratings</option>
                                <option value="5">5 Stars</option>
                                <option value="4">4 Stars</option>
                                <option value="3">3 Stars</option>
                                <option value="2">2 Stars ⚠️</option>
                                <option value="1">1 Star ⚠️</option>
                            </select>
                            <select id="filterStatus" class="filter-select">
                                <option value="">All Status</option>
                                <option value="PUBLISHED">Published</option>
                                <option value="HIDDEN">Hidden</option>
                            </select>
                        </div>
                    </div>
                </div>

            <!-- Reviews Table -->
            <div class="table-container">
                <table class="reviews-table">
                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th>Product</th>
                            <th>Rating</th>
                            <th>Comment</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (reviews && reviews.length > 0) { %>
                            <% reviews.forEach(function(review) { %>
                                <tr class="review-row <%= review.isLowRating ? 'low-rating' : '' %>" data-review-id="<%= review._id %>">
                                    <td>
                                        <div class="customer-info">
                                            <% if (review.memberId && review.memberId.memberImage) { %>
                                                <img src="<%= serverApi %>/<%= review.memberId.memberImage %>" alt="<%= review.memberId.memberNick %>" class="customer-avatar">
                                            <% } else { %>
                                                <img src="<%= serverApi %>/img/default_img.jpg" alt="Customer" class="customer-avatar">
                                            <% } %>
                                            <div>
                                                <div class="customer-name"><%= review.memberId ? review.memberId.memberNick : 'Unknown' %></div>
                                                <div class="customer-email"><%= review.memberId ? review.memberId.memberEmail : 'N/A' %></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="product-info">
                                            <% if (review.productId && review.productId.productImages && review.productId.productImages[0]) { %>
                                                <img src="<%= serverApi %>/<%= review.productId.productImages[0] %>" alt="<%= review.productId.productName %>" class="product-image">
                                            <% } %>
                                            <span class="product-name"><%= review.productId ? review.productId.productName : 'N/A' %></span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="rating-stars" data-rating="<%= review.rating %>">
                                            <% for (let i = 1; i <= 5; i++) { %>
                                                <span class="star <%= i <= review.rating ? 'filled' : '' %>">★</span>
                                            <% } %>
                                        </div>
                                        <% if (review.isLowRating) { %>
                                            <span class="low-rating-badge">⚠️ Low</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <div class="review-comment">
                                            <%= review.comment || 'No comment provided' %>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="review-date">
                                            <%= new Date(review.createdAt).toLocaleDateString('en-US', { 
                                                year: 'numeric', 
                                                month: 'short', 
                                                day: 'numeric' 
                                            }) %>
                                        </div>
                                        <div class="review-time">
                                            <%= new Date(review.createdAt).toLocaleTimeString('en-US', { 
                                                hour: '2-digit', 
                                                minute: '2-digit' 
                                            }) %>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="status-badge <%= review.status.toLowerCase() %>">
                                            <%= review.status %>
                                        </span>
                                    </td>
                                    <td>
                                        <div class="action-buttons-modern">
                                            <button class="btn-action btn-reply" data-review-id="<%= review._id %>" data-customer-name="<%= review.memberId ? review.memberId.memberNick : 'Customer' %>" onclick="openReplyModal(this)" title="Reply to review">
                                                <i class="fas fa-reply"></i>
                                            </button>
                                            <% if (review.status === 'PUBLISHED') { %>
                                                <button class="btn-action btn-hide" onclick="hideReview('<%= review._id %>')" title="Hide review">
                                                    <i class="fas fa-eye-slash"></i>
                                                </button>
                                            <% } else { %>
                                                <button class="btn-action btn-show" onclick="showReview('<%= review._id %>')" title="Show review">
                                                    <i class="fas fa-eye"></i>
                                                </button>
                                            <% } %>
                                            <button class="btn-action btn-edit" onclick="requestUpdate('<%= review._id %>')" title="Request update">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="no-data">No reviews found</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
        </main>
    </div>

    <!-- Reply Modal -->
    <div id="replyModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Reply to Review</h2>
                <span class="close" onclick="closeReplyModal()">&times;</span>
            </div>
            <div class="modal-body">
                <p>Replying to: <strong id="customerName"></strong></p>

                <!-- ✅ ADDED: hidden reviewId for sending reply -->
                <input type="hidden" id="replyReviewId" />

                <textarea id="replyMessage" placeholder="Type your reply here..." rows="5"></textarea>
            </div>
            <div class="modal-footer">
                <button class="btn-cancel" onclick="closeReplyModal()">Cancel</button>
                <button class="btn-submit" onclick="submitReply()">Send Reply</button>
            </div>
        </div>
    </div>

    <script src="/js/review.js"></script>
</body>
</html>
